# Обратный прокси режима демонстрации (docker-compose.public.yml).
# Сертификат для PUBLIC_DOMAIN выпускается через проверку DNS в DuckDNS: входящие
# порты 80 и 443 для этого не нужны. Снаружи сайт открывается на PUBLIC_PORT,
# который роутер перенаправляет на порт 443 этого ПК.

{
	servers {
		# Без HTTP/3: Caddy объявляет его на внутреннем порту 443 (Alt-Svc), а снаружи сайт
		# на другом порту, и браузер тратит время на попытки подключиться к закрытому порту
		protocols h1 h2
	}
}

{$PUBLIC_DOMAIN} {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}

	# Служебные страницы из интернета недоступны; автор открывает их на ПК: http://localhost:8000
	@internal path /metrics /metrics/* /api/metrics /api/docs /api/docs/* /api/openapi.json /invite
	respond @internal 404

	# Лимит тела запроса до того, как оно дойдёт до API: файл до 10 МБ + служебные поля формы
	request_body {
		max_size 11MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Ключ из ссылки-приглашения не должен уходить в заголовке Referer
		Referrer-Policy "no-referrer"
		-Server
	}

	encode gzip
	reverse_proxy api:8000

	# Журнал запросов с реальным IP клиента; ключ из адреса вырезается
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete key
				}
			}
		}
	}
}

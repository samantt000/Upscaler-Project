# Скопируйте в .env и при необходимости измените значения.

# Чтобы `docker compose up -d --build` сразу запускал GPU-режим (NFR-013 — одна команда),
# раскомментируйте строку. Разделитель файлов в Windows — «;», в Linux/macOS — «:».
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# Адрес и порт сайта на ПК. 0.0.0.0 — доступ с этого ПК и из локальной сети;
# 127.0.0.1 — только с этого ПК.
HOST_BIND=0.0.0.0
HOST_PORT=8000

# auto — GPU при наличии, иначе CPU; cpu — принудительно CPU (например, для замеров CPU-режима)
DEVICE=auto
# Размер фрагмента изображения при обработке. Для RTX 3070 (8 ГБ) подходит 512;
# при нехватке видеопамяти уменьшите до 256.
TILE_SIZE=512
# Число потоков CPU для PyTorch (0 — автоматически)
TORCH_THREADS=0

# FR-010: срок хранения файлов, секунды (24 ч). Для ускоренной проверки удаления: 120
RETENTION_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=600

# FR-006: на сколько снижается достройка в области лиц (0.5 = на 50%; требование — не менее 30%)
FACE_DETAIL_REDUCTION=0.5

# FR-012: базовая линия BRISQUE — среднее по набору C (выводит tools.eval_metrics noref)
BRISQUE_BASELINE=
